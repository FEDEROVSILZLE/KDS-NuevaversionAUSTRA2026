model products {
  id                     String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  official_name          String               @db.VarChar(200)
  base_unit              String               @db.VarChar(20)
  condition              String?              @db.VarChar(50)
  sub_condition          String?              @db.VarChar(50)
  is_for_branches        Boolean?             @default(false)
  is_produced_in_kitchen Boolean?             @default(false)
  is_produced_in_fabrica Boolean?             @default(false)
  is_produced_in_armado  Boolean?             @default(false)
  is_fractionable        Boolean?             @default(false)
  description            String?
  internal_code          String?              @db.VarChar(50)
  codigo_tango           Decimal?             @db.Decimal
  is_active              Boolean?             @default(true)
  created_at             DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?            @default(now()) @db.Timestamptz(6)
  recipe_ingredients     recipe_ingredients[]
  recipes                recipes?
  supply_rules           supply_rules[]
  branch_order_items     branch_order_items[]
  branch_stock           branch_stock[]
  order_items            order_items[]
  shipment_items         shipment_items[]
  stock                  stock[]
  stock_count            stock_count[]
  stock_count_config     stock_count_config[]
  stock_lots             stock_lots[]
  stock_movements        stock_movements[]

  @@schema("core")
}

