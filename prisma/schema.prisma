generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["audit", "core", "operations", "public", "staging"]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model order_lifecycle {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type     String        @db.VarChar(50)
  entity_id       String        @db.Uuid
  previous_status order_status?
  new_status      order_status
  changed_by      String?       @db.VarChar(100)
  changed_at      DateTime?     @default(now()) @db.Timestamptz(6)
  notes           String?
  metadata        Json?         @default("{}")

  @@index([changed_at(sort: Desc)], map: "idx_lifecycle_changed_at")
  @@index([changed_at(sort: Desc)], map: "idx_lifecycle_date")
  @@index([entity_type, entity_id], map: "idx_lifecycle_entity")
  @@index([new_status], map: "idx_lifecycle_status")
  @@schema("audit")
}

